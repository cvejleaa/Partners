rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Admin = whitelisted email OG verificeret email. email_verified-kravet
    // forhindrer at en nyoprettet uverificeret konto med den rigtige adresse
    // (email/password sætter email_verified=false indtil verifikation) kan
    // opnå admin-rettigheder.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in [
          'cvejleaa@gmail.com'
        ];
    }

    // Kortregel-konfiguration: alle kan læse (nye spil arver den). KUN admin
    // må skrive — ellers kunne enhver indlogget bruger gøre spillet uspilleligt
    // for alle på tværs af siten. Admin-skærmen er den eneste skriver.
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Brugerprofiler. Læsbar af alle indloggede (så venne-søgning kan finde
    // dem). Skrivbar kun af ejeren selv.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;

      // Venneliste — den lokale kopi af hvem en bruger har som ven.
      // Læses og skrives kun af ejeren.
      match /friends/{friendUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Indbakke — invitationer fra andre. Ejeren kan læse, opdatere og slette.
      // Andre indloggede må KUN oprette en invitation, og kun med deres EGEN
      // uid som afsender (fromUid) — så afsendernavn/-id ikke kan forfalskes,
      // og af typen 'gameInvite'. Forhindrer spoofede invitationer + push-spam
      // med falsk afsender (Cloud Function onInboxCreate sender push herpå).
      match /inbox/{inviteId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type == 'gameInvite'
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 60
          && request.resource.data.gameCode is string
          && request.resource.data.gameCode.size() <= 12;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Spil.
    //  - create: enhver indlogget, men kun med sig selv som vært.
    //  - update: KUN medlemmer af spillet, ELLER hvis spillet stadig er i
    //    lobby (så nye spillere kan joine en åben lobby). Når spillet er
    //    'playing' kan udenforstående ikke længere pille ved state — det
    //    lukker for at en tilfældig bruger overskriver et igangværende spil.
    //  - delete: kun vært eller admin.
    match /games/{game} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        resource.data.status == 'lobby'
      );
      allow delete: if isSignedIn() &&
        (resource.data.hostUid == request.auth.uid || isAdmin());

      // Presence (heartbeat) pr. spiller i en subcollection, så de hyppige
      // tilstedeværelses-skrivninger IKKE rører selve spil-doc'et (og dermed
      // hverken trigger onGameTurn eller snapshots på spil-state'en). Alle
      // indloggede må læse markørerne; man må kun skrive sit EGET stempel.
      match /presence/{uid} {
        allow read: if isSignedIn();
        // Kun sit EGET stempel, og kun formen {t: <timestamp>} — så et
        // presence-doc hverken kan bloates eller spoofes med et fremtidigt
        // stempel af andre felter.
        allow write: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['t'])
          && request.resource.data.t is timestamp;
      }
    }

    // Stats-cache pr. bruger: alle indloggede må læse (ranglisterne viser
    // andres stats). Skrivning: KUN ejeren af doc'et (hver klient skriver sin
    // egen ved spil-slut), eller admin (genberegning/nulstilling). Forhindrer
    // at en bruger forfalsker eller saboterer ANDRES stats.
    match /userStats/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        (request.auth.uid == uid || isAdmin());
    }

    // Online-kun stats-cache: samme som userStats, men beregnet UDEN
    // AI-solospil. Driver den offentlige rangliste, så man ikke kan klatre ved
    // at slå let AI. Egen profil bruger fortsat userStats (samlet, inkl. AI).
    match /userStatsOnline/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        (request.auth.uid == uid || isAdmin());
    }
  }
}
