rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'cvejleaa@gmail.com'
        ];
    }

    // Kortregel-konfiguration: alle kan læse. Indtil admin-flowet er
    // bekræftet (oprette konto + logge ind som admin) tillader vi at alle
    // indloggede brugere kan skrive. Strammes til isAdmin() når flow er ok.
    match /config/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Brugerprofiler. Læsbar af alle indloggede (så søgning kan finde dem).
    // Skrivbar kun af ejeren selv.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;

      // Venneliste — den lokale kopi af hvem en bruger har som ven.
      // Læses og skrives kun af ejeren.
      match /friends/{friendUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Indbakke — invitationer fra andre. Ejeren kan læse og slette.
      // Andre indloggede må oprette nye dokumenter (så de kan sende
      // invitationer), men ikke ændre eller slette eksisterende.
      match /inbox/{inviteId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Spil.
    match /games/{game} {
      allow read, write: if isSignedIn();
    }

    // Stats-cache pr. bruger: alle indloggede må læse (profilskærmen viser
    // andres stats); skrivning sker fra klienten der lige har afsluttet et
    // spil (foreløbig: alle indloggede må skrive).
    match /userStats/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
