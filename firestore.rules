rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Admin = whitelisted email OG verificeret email. email_verified-kravet
    // forhindrer at en nyoprettet uverificeret konto med den rigtige adresse
    // (email/password sætter email_verified=false indtil verifikation) kan
    // opnå admin-rettigheder.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in [
          'cvejleaa@gmail.com'
        ];
    }

    // Kortregel-konfiguration: alle kan læse (nye spil arver den). KUN admin
    // må skrive — ellers kunne enhver indlogget bruger gøre spillet uspilleligt
    // for alle på tværs af siten. Admin-skærmen er den eneste skriver.
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Brugerprofiler. Læsbar af alle indloggede (så venne-søgning kan finde
    // dem). Skrivbar kun af ejeren selv.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;

      // Venneliste — den lokale kopi af hvem en bruger har som ven.
      // Læses og skrives kun af ejeren.
      match /friends/{friendUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Indbakke — invitationer fra andre. Ejeren kan læse, opdatere og slette.
      // Andre indloggede må KUN oprette en invitation, og kun med deres EGEN
      // uid som afsender (fromUid) — så afsendernavn/-id ikke kan forfalskes,
      // og af typen 'gameInvite'. Forhindrer spoofede invitationer + push-spam
      // med falsk afsender (Cloud Function onInboxCreate sender push herpå).
      match /inbox/{inviteId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type == 'gameInvite'
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 60
          && request.resource.data.gameCode is string
          && request.resource.data.gameCode.size() <= 12;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Spil.
    //  - create: enhver indlogget, men kun med sig selv som vært.
    //  - update: KUN medlemmer af spillet, ELLER hvis spillet stadig er i
    //    lobby (så nye spillere kan joine en åben lobby). Når spillet er
    //    'playing' kan udenforstående ikke længere pille ved state — det
    //    lukker for at en tilfældig bruger overskriver et igangværende spil.
    //  - delete: kun vært eller admin.
    match /games/{game} {
      // Man må KUN sætte SIG SELV ind i et spil. Uden dette kunne enhver
      // indlogget fabrikere et spil med FREMMEDE uid'er (eller redigere en
      // åben lobby) og dermed: forgifte ofrenes statistik (den genberegnes
      // ud fra alle spil der nævner ens uid), udløse server-skrivninger på
      // deres vegne (onGameOver-markeringen) og spamme dem med "din tur"-push.
      // Alle tre angreb er efterprøvet i emulatoren — se rules.test.mjs.
      // null er tilladt, så en tom plads (og et sædeskift) stadig kan skrives.
      // .get(...) overalt: et dokument uden feltet må give AFVISNING af et
      // fremmed uid, ikke en regel-FEJL (som ville afvise alt, også de ægte
      // flows).
      function onlySelfInSeats() {
        return request.resource.data.get('uids', [])
            .hasOnly(resource.data.get('uids', [])
                .concat([request.auth.uid, null]));
      }
      // Lader skrivningen ANDRES sæder stå? `onlySelfInSeats` alene gjorde det
      // ikke: den kræver kun at den NYE liste er en delmængde af den gamle
      // plus mig selv og null — så man kunne overskrive fremmede sæder med
      // sine egne/null.
      //
      // Det blev FARLIGERE af sæde-kravet nedenfor, og det er en regression,
      // denne rettelse selv indførte (efterprøvet i emulatoren): skubbede
      // Mallory værten ud af en åben lobby og flippede til 'playing', var
      // værten LÅST ude af sit eget spil for altid — før kunne hun stadig
      // skrive via 'members'. Samme vej kunne et helt spil "brickes" ved at
      // tømme `uids`: så er ingen længere siddende, og dokumentet er
      // uskrivbart for alle.
      //
      // Genkendt på positiv tilstedeværelse: alle andres uid'er skal stadig
      // være der. Mit eget sæde og tomme pladser må jeg flytte — det er
      // netop hvad joinGame gør ved et sædeskift.
      function othersSeatsKept() {
        return request.resource.data.get('uids', [])
            .hasAll(resource.data.get('uids', [])
                .removeAll([null, request.auth.uid]));
      }
      // Sidder JEG med ved bordet? Det er den eneste egenskab, man ikke kan
      // give sig selv: 'uids' er låst af onlySelfInSeats, mens 'members'
      // bevidst er ubegrænset (invite() skal kunne tilføje den inviterede,
      // ellers dør invitationer og revanche).
      function selfSeated() {
        return request.auth.uid in resource.data.get('uids', []);
      }
      // Kun nogen med et SÆDE må ændre status.
      //
      // Stod der 'members' her, kunne en vilkårlig udenforstående overtage
      // enhver åben lobby i to trin — efterprøvet i emulatoren:
      //   1) update {members: [... , mig]}  — status uændret, doc er lobby → OK
      //   2) nu "medlem" → update {status: 'playing'}                    → OK
      //   3) og derfra skrive 'state' på et IGANGVÆRENDE fremmed spil:
      //      ændre brættet, og udløse "din tur"-push i ring.
      // Angriberen behøvede aldrig et sæde. Den GAMLE test dækkede kun
      // ét-trins-angrebet (og var grøn), så hullet så lukket ud.
      function statusUnchangedOrSeated() {
        return request.resource.data.get('status', '') ==
                resource.data.get('status', '')
            || selfSeated();
      }
      // Rører skrivningen KUN mit eget 'seen'-stempel?
      //
      // Undtagelsen findes, fordi man kan være inviteret uden at have taget
      // plads: sådan et spil står i ens arkiv, og åbner man det, skriver
      // markSeen 'seen.<mig>'. Uden denne gren ville sæde-kravet nedenfor
      // slå netop dét flow ihjel.
      function onlyOwnSeen() {
        return request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['seen'])
            && request.resource.data.get('seen', {})
                .diff(resource.data.get('seen', {})).affectedKeys()
                .hasOnly([request.auth.uid])
            // markSeen skriver et heltal. Uden denne grænse kunne et medlem
            // uden sæde skrive en kæmpe streng under sin egen nøgle og puste
            // spil-dokumentet op mod Firestores 1 MiB-loft, så de rigtige
            // spillere ikke længere kunne skrive i det.
            && request.resource.data.get('seen', {})
                .get(request.auth.uid, 0) is int;
      }
      allow read: if isSignedIn();
      // Oprettelse: kun med sig selv som vært, som eneste medlem og som
      // eneste besatte plads. (Status er bevidst fri: online-spil oprettes
      // som 'lobby', mens et færdigspillet AI-solospil gemmes direkte som
      // 'over' — begge kun med opretterens egen uid.)
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.get('members', []).hasOnly([request.auth.uid])
        && request.resource.data.get('uids', [])
            .hasOnly([request.auth.uid, null]);
      // Adgangsporten: et SÆDE i spillet, eller en åben lobby (så man kan
      // tage plads), eller den snævre seen-undtagelse for en inviteret, der
      // aldrig satte sig. At stå i 'members' er IKKE længere nok til at
      // skrive i et igangværende spil — det var vej 3 i angrebet ovenfor.
      allow update: if isSignedIn()
        && onlySelfInSeats()
        && othersSeatsKept()
        // Værtskabet er ikke et almindeligt felt: sletning hviler på det
        // ('resource.data.hostUid == request.auth.uid' nedenfor), så kunne man
        // skrive sig selv som vært, kunne man slette andres spil. Efterprøvet
        // i emulatoren i to skridt, før denne linje. Der findes ingen
        // vært-overdragelse i klienten, så feltet må aldrig ændre sig.
        && request.resource.data.get('hostUid', '') ==
             resource.data.get('hostUid', '')
        && statusUnchangedOrSeated()
        && (
          selfSeated() ||
          // .get() også her: husets konvention i denne fil er, at et doc uden
          // feltet skal give AFVISNING, ikke en regel-FEJL (som ville afvise
          // alt, også de ægte flows).
          resource.data.get('status', '') == 'lobby' ||
          (request.auth.uid in resource.data.get('members', []) && onlyOwnSeen())
        );
      allow delete: if isSignedIn() &&
        (resource.data.hostUid == request.auth.uid || isAdmin());

      // Presence (heartbeat) pr. spiller i en subcollection, så de hyppige
      // tilstedeværelses-skrivninger IKKE rører selve spil-doc'et (og dermed
      // hverken trigger onGameTurn eller snapshots på spil-state'en). Alle
      // indloggede må læse markørerne; man må kun skrive sit EGET stempel.
      match /presence/{uid} {
        allow read: if isSignedIn();
        // Kun sit EGET stempel, og kun formen {t: <timestamp>} — så et
        // presence-doc hverken kan bloates eller spoofes med et fremtidigt
        // stempel af andre felter.
        allow write: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['t'])
          && request.resource.data.t is timestamp;
      }
    }

    // Stats-cache pr. bruger: alle indloggede må læse (ranglisterne viser
    // andres stats). Skrivning: KUN ejeren af doc'et (hver klient skriver sin
    // egen ved spil-slut), eller admin (genberegning/nulstilling). Forhindrer
    // at en bruger forfalsker eller saboterer ANDRES stats.
    match /userStats/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        (request.auth.uid == uid || isAdmin());
    }

    // Online-kun stats-cache: samme som userStats, men beregnet UDEN
    // AI-solospil. Driver den offentlige rangliste, så man ikke kan klatre ved
    // at slå let AI. Egen profil bruger fortsat userStats (samlet, inkl. AI).
    match /userStatsOnline/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        (request.auth.uid == uid || isAdmin());
    }
  }
}
